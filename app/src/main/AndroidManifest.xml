<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".AzkarApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Azkar"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Azkar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".widgets.WidgetClockReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".widgets.SmallWidgetProvider" android:exported="true" android:label="Azkar - Small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver android:name=".widgets.MediumWidgetProvider" android:exported="true" android:label="Azkar - Wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium_info" />
        </receiver>
        <receiver android:name=".widgets.LargeWidgetProvider" android:exported="true" android:label="Azkar - Large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>
        <receiver android:name=".widgets.BSmallWidgetProvider" android:exported="true" android:label="@string/azkar_widget_b_small_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_b_small_info" /></receiver>
        <receiver android:name=".widgets.BMediumWidgetProvider" android:exported="true" android:label="@string/azkar_widget_b_medium_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_b_medium_info" /></receiver>
        <receiver android:name=".widgets.DSmallWidgetProvider" android:exported="true" android:label="@string/azkar_widget_d_small_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_d_small_info" /></receiver>
        <receiver android:name=".widgets.DMediumWidgetProvider" android:exported="true" android:label="@string/azkar_widget_d_medium_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_d_medium_info" /></receiver>
        <receiver android:name=".widgets.DLargeWidgetProvider" android:exported="true" android:label="@string/azkar_widget_d_large_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_d_large_info" /></receiver>
        <receiver android:name=".widgets.HSmallWidgetProvider" android:exported="true" android:label="@string/azkar_widget_h_small_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_h_small_info" /></receiver>
        <receiver android:name=".widgets.HMediumWidgetProvider" android:exported="true" android:label="@string/azkar_widget_h_medium_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_h_medium_info" /></receiver>
        <receiver android:name=".widgets.HLargeWidgetProvider" android:exported="true" android:label="@string/azkar_widget_h_large_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_h_large_info" /></receiver>
        <receiver android:name=".widgets.JStripDhikrWidgetProvider" android:exported="true" android:label="@string/azkar_widget_j_strip_dhikr_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_j_strip_dhikr_info" /></receiver>
        <receiver android:name=".widgets.JStripProgressWidgetProvider" android:exported="true" android:label="@string/azkar_widget_j_strip_progress_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_j_strip_progress_info" /></receiver>
        <receiver android:name=".widgets.JTallRingWidgetProvider" android:exported="true" android:label="@string/azkar_widget_j_tall_ring_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_j_tall_ring_info" /></receiver>
        <receiver android:name=".widgets.JTallTimelineWidgetProvider" android:exported="true" android:label="@string/azkar_widget_j_tall_timeline_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_j_tall_timeline_info" /></receiver>
        <!-- Tracking widgets: enabled only while a folder is tracked (NewWidgetUpdater.syncTrackingProviders) -->
        <receiver android:name=".widgets.CStreakSmallWidgetProvider" android:enabled="false" android:exported="true" android:label="@string/azkar_widget_c_streak_small_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_c_streak_small_info" /></receiver>
        <receiver android:name=".widgets.CStreakMediumWidgetProvider" android:enabled="false" android:exported="true" android:label="@string/azkar_widget_c_streak_medium_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_c_streak_medium_info" /></receiver>
        <receiver android:name=".widgets.CStreakLargeWidgetProvider" android:enabled="false" android:exported="true" android:label="@string/azkar_widget_c_streak_large_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_c_streak_large_info" /></receiver>
        <receiver android:name=".widgets.GCountdownSmallWidgetProvider" android:enabled="false" android:exported="true" android:label="@string/azkar_widget_g_countdown_small_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_g_countdown_small_info" /></receiver>
        <receiver android:name=".widgets.FBentoSmallWidgetProvider" android:enabled="false" android:exported="true" android:label="@string/azkar_widget_f_bento_small_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_f_bento_small_info" /></receiver>
        <receiver android:name=".widgets.TTodayMediumWidgetProvider" android:enabled="false" android:exported="true" android:label="@string/azkar_widget_t_today_medium_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/azkar_widget_t_today_medium_info" /></receiver>
        <receiver android:name=".widgets.WidgetPinReceiver" android:exported="false" />
        <!-- Widget config activity -->
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:label="Configure Azkar Widget"
            android:theme="@style/Theme.Azkar.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
