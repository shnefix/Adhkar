<?xml version="1.0" encoding="utf-8"?>
<!-- The widgets' black card. Drawn by the layout, so it always fills the space the launcher gives the widget,
     whatever size the launcher reported; the picture on top keeps its own proportions. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/azkar_widget_ink" />
    <stroke android:width="1dp" android:color="@color/azkar_widget_card_border" />
    <corners android:radius="26dp" />
</shape>
