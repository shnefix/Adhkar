<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Azkar" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textColorHighlight">@color/gold_highlight</item>
        <item name="colorControlActivated">@color/gold</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="alertDialogTheme">@style/AzkarAlertDialog</item>
    </style>

    <!-- Base text -->
    <style name="T" parent="android:Widget.TextView">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/dm_sans_regular</item>
    </style>
    <style name="TM" parent="T"><item name="android:fontFamily">@font/dm_sans_medium</item></style>
    <style name="TB" parent="T"><item name="android:fontFamily">@font/dm_sans_bold</item></style>
    <style name="Ar" parent="T"><item name="android:fontFamily">@font/amiri_regular</item></style>
    <style name="ArB" parent="T"><item name="android:fontFamily">@font/amiri_bold</item></style>
    <style name="Caps" parent="TB">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Btn" parent="android:Widget.Button">
        <item name="android:background">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AzkarAlertDialog" parent="Theme.AppCompat.Dialog.Alert"/>
</resources>
