<resources>
    <style name="WidgetEditorLabel" parent="TB">
        <item name="android:textColor">@color/widget_editor_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.122</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="WidgetEditorBody" parent="T">
        <item name="android:textColor">@color/widget_editor_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="WidgetEditorMedium" parent="TM">
        <item name="android:textColor">@color/widget_editor_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="WidgetEditorButton" parent="Btn">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
