<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:scrollbars="none" android:overScrollMode="never" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="56dp" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="32dp">
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<FrameLayout android:id="@+id/btn_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_card22" android:contentDescription="Back to My azkar" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_chev_l_2" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
<TextView style="@style/TB" android:text="Edit folder" android:textSize="18sp" android:textColor="@color/text" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<View android:layout_width="44dp" android:layout_height="44dp"/>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/TB" android:text="Folder name" android:textSize="14sp" android:textColor="@color/light" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_height="52dp" android:paddingHorizontal="18dp" android:gravity="center_vertical" android:background="@drawable/bg_in26" android:layout_marginTop="8dp" android:layout_width="match_parent">
<ImageView android:src="@drawable/ic_folder_1p75" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/gold"/>
<EditText style="@style/T" android:id="@+id/fname" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="10dp" android:background="@null" android:hint="Folder name" android:textColorHint="@color/hint" android:textColor="@color/text" android:textSize="16sp" android:inputType="textCapSentences" android:singleLine="true" android:padding="0dp"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="64dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="18dp" android:paddingEnd="14dp" android:background="@drawable/bg_card22" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
<TextView style="@style/TB" android:text="Show on Home" android:textSize="16sp" android:textColor="@color/text" android:lineHeight="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:text="Appears on your Home screen" android:textSize="14sp" android:textColor="@color/muted" android:id="@+id/home_sub" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<com.azkar.app.ui.ToggleSwitch android:id="@+id/sw_home" android:layout_width="56dp" android:layout_height="44dp" android:contentDescription="Show on Home"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="64dp" android:layout_marginTop="12dp" android:paddingStart="18dp" android:paddingEnd="6dp" android:background="@drawable/bg_card22" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/TB" android:text="Position in Library" android:textSize="16sp" android:textColor="@color/text" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<FrameLayout android:id="@+id/lib_up" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Move up" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_chev_up_2p25" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
<FrameLayout android:id="@+id/lib_down" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Move down" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_chev_dn_2p25" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/Caps" android:text="Order" android:textSize="13sp" android:textColor="@color/muted" android:id="@+id/order_label" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="vertical" android:id="@+id/rows" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:text="No azkar in this folder yet. Add your first one below." android:textSize="15sp" android:textColor="@color/muted" android:lineHeight="22sp" android:id="@+id/empty" android:gravity="center" android:paddingVertical="28dp" android:paddingHorizontal="18dp" android:background="@drawable/bg_dashline20" android:layout_marginTop="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="16dp"/>
<LinearLayout android:orientation="horizontal" android:id="@+id/btn_add" android:layout_height="56dp" android:gravity="center" android:background="@drawable/bg_gold28" android:clickable="true" android:focusable="true" android:layout_marginTop="16dp" android:layout_width="match_parent">
<ImageView android:src="@drawable/ic_plus_2p25" android:layout_width="22dp" android:layout_height="22dp" android:tint="@color/bg"/>
<TextView style="@style/TB" android:text="Add zikr to this folder" android:textSize="17sp" android:textColor="@color/bg" android:layout_marginStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView style="@style/TB" android:text="Delete folder" android:textSize="15sp" android:textColor="@color/danger" android:id="@+id/btn_delete" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true"/>
</LinearLayout>
</ScrollView>
