<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="horizontal" android:layout_height="52dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="6dp" android:background="@drawable/bg_card18" android:id="@+id/row" android:layout_width="match_parent">
<ImageView android:src="@drawable/ic_folder_1p75" android:layout_width="22dp" android:layout_height="22dp" app:tint="@color/gold" android:id="@+id/ic"/>
<TextView android:id="@+id/emoji" android:visibility="gone" android:textSize="18sp" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView style="@style/TB" android:text="" android:textSize="15sp" android:textColor="@color/text" android:id="@+id/name" android:layout_weight="1" android:layout_width="0dp" android:layout_marginStart="10dp" android:singleLine="true" android:ellipsize="end" android:layout_height="wrap_content"/>
<FrameLayout android:id="@+id/up" android:layout_width="44dp" android:layout_height="44dp" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_chev_up_2p25" android:layout_width="20dp" android:layout_height="20dp" app:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
<FrameLayout android:id="@+id/down" android:layout_width="44dp" android:layout_height="44dp" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_chev_dn_2p25" android:layout_width="20dp" android:layout_height="20dp" app:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
<FrameLayout android:id="@+id/toggle" android:layout_width="44dp" android:layout_height="44dp" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_eye_1p75" android:layout_width="22dp" android:layout_height="22dp" app:tint="@color/gold" android:layout_gravity="center" android:id="@+id/eye"/>
</FrameLayout>
</LinearLayout>
