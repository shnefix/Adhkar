<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="88dp" android:clipToPadding="false" android:scrollbars="none" android:overScrollMode="never" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:id="@+id/content" android:paddingTop="60dp" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/TB" android:text="Reminders" android:textSize="28sp" android:textColor="@color/text" android:lineHeight="36sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:text="Gentle nudges at the times you choose." android:textSize="15sp" android:textColor="@color/muted" android:lineHeight="22sp" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/Caps" android:text="Daily reminders" android:textSize="13sp" android:textColor="@color/muted" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="vertical" android:id="@+id/reminders" android:layout_marginTop="10dp" android:background="@drawable/bg_card24" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/Caps" android:text="Reading" android:textSize="13sp" android:textColor="@color/muted" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="vertical" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="vertical" android:background="@drawable/bg_card24" android:id="@+id/reading" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="64dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="18dp" android:paddingEnd="14dp" android:background="@null" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
<TextView style="@style/TB" android:text="Show translation" android:textSize="16sp" android:textColor="@color/text" android:lineHeight="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:text="English under each dhikr" android:textSize="14sp" android:textColor="@color/muted" android:id="@+id/tr_sub" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<com.azkar.app.ui.ToggleSwitch android:id="@+id/sw_tr" android:layout_width="56dp" android:layout_height="44dp" android:contentDescription="Show translation"/>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="18dp" android:paddingHorizontal="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/TB" android:text="Arabic text size" android:textSize="16sp" android:textColor="@color/text" android:lineHeight="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:id="@+id/sizes" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</ScrollView>
<include layout="@layout/view_nav" android:layout_width="match_parent" android:layout_height="88dp" android:layout_gravity="bottom"/>
</FrameLayout>
