<?xml version="1.0" encoding="utf-8"?>
<!-- Customize: a Home tab (order, visibility) and a Library tab (order), each with a live preview above a
     grid of folder tiles you press and hold to drag. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:background="@color/bg" android:paddingTop="56dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<FrameLayout android:id="@+id/btn_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_card22" android:contentDescription="@string/back_to_home" android:clickable="true" android:focusable="true">
<ImageView android:importantForAccessibility="no" android:src="@drawable/ic_chev_l_2" android:layout_width="20dp" android:layout_height="20dp" app:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
<TextView style="@style/TB" android:text="@string/customize" android:textSize="18sp" android:textColor="@color/text" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<TextView style="@style/TB" android:text="@string/done" android:textSize="15sp" android:textColor="@color/bg" android:id="@+id/btn_done" android:layout_height="44dp" android:paddingHorizontal="18dp" android:gravity="center" android:background="@drawable/bg_gold22" android:clickable="true" android:focusable="true" android:layout_width="wrap_content"/>
</LinearLayout>
<LinearLayout android:id="@+id/tabs" android:orientation="horizontal" android:layout_marginTop="16dp" android:padding="4dp" android:background="@drawable/bg_card22" android:layout_width="match_parent" android:layout_height="48dp"/>
<LinearLayout android:id="@+id/style_row" android:orientation="horizontal" android:layout_marginTop="10dp" android:padding="4dp" android:background="@drawable/bg_card22" android:layout_width="match_parent" android:layout_height="48dp"/>
<TextView style="@style/Caps" android:text="@string/preview" android:layout_marginTop="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/preview" android:orientation="vertical" android:layout_marginTop="8dp" android:padding="8dp" android:background="@drawable/bg_prev18" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:id="@+id/hint" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/tiles" android:layout_marginTop="6dp" android:layout_marginHorizontal="-4dp" android:clipToPadding="false" android:overScrollMode="never" android:scrollbars="none" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp"/>
<TextView style="@style/TB" android:id="@+id/btn_reset" android:text="@string/reset_home" android:textSize="15sp" android:textColor="@color/muted" android:gravity="center" android:background="@drawable/bg_card22" android:clickable="true" android:focusable="true" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="44dp"/>
</LinearLayout>
