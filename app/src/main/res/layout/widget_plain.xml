<?xml version="1.0" encoding="utf-8"?>
<!-- Bitmap + two tap areas: the top strip opens the app, the rest counts +1. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/img" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:id="@+id/hit_open" android:layout_width="match_parent" android:layout_height="30dp"/>
        <FrameLayout android:id="@+id/hit_count" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
