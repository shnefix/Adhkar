<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="@drawable/bg_notif_day"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:id="@+id/n_title" android:fontFamily="@font/dm_sans_bold" android:textSize="15sp" android:textColor="@color/notif_day_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/n_body" android:fontFamily="@font/dm_sans_regular" android:textSize="13sp" android:textColor="@color/notif_day_muted" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/n_ar" android:fontFamily="@font/amiri_bold" android:textSize="22sp" android:textColor="@color/gold" android:layout_marginStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
