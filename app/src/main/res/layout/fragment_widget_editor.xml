<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_editor_black">
    <ScrollView
        android:id="@+id/editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/editor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="48dp"
            android:paddingEnd="20dp"
            android:paddingBottom="104dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true">
                    <ImageView android:importantForAccessibility="no"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chev_l_2"
                        app:tint="@color/widget_editor_text" />
                </FrameLayout>
                <TextView
                    style="@style/TB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_editor_title"
                    android:textColor="@color/widget_editor_text"
                    android:textSize="19sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_choose_widget"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/widget_editor_surface2_gold"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card14_black">
                    <ImageView android:importantForAccessibility="no"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_plus_2"
                        app:tint="@color/widget_editor_gold" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <TextView
                        style="@style/TB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/choose_widget"
                        android:textColor="@color/widget_editor_text"
                        android:textSize="15sp" />
                    <TextView
                        style="@style/T"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_sizes"
                        android:textColor="@color/widget_editor_muted"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView android:importantForAccessibility="no"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chev_r_2"
                    app:tint="@color/widget_editor_muted" />
            </LinearLayout>
            <TextView
                style="@style/WidgetEditorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:text="@string/widgets_on_home" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/placed_widgets"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
            <LinearLayout
                android:id="@+id/preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/widget_editor_preview"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/WidgetEditorLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/live_preview" />
                    <TextView
                        android:id="@+id/preview_size"
                        style="@style/TM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_editor_gold"
                        android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/preview_face"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/widget_editor_preview_face"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/preview_arabic"
                        style="@style/ArB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/widget_editor_gold"
                        android:textSize="28sp" />
                    <TextView
                        android:id="@+id/preview_meta"
                        style="@style/T"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/widget_editor_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <HorizontalScrollView
                android:id="@+id/editor_tabs_scroll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:fillViewport="true"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/editor_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
            <FrameLayout
                android:id="@+id/tab_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/editor_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:background="@color/widget_editor_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">
        <TextView
            android:id="@+id/btn_reset"
            style="@style/WidgetEditorButton"
            android:layout_width="96dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_editor_surface1"
            android:gravity="center"
            android:text="@string/reset"
            android:textColor="@color/widget_editor_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/btn_apply"
            style="@style/WidgetEditorButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/widget_editor_button_gold"
            android:gravity="center"
            android:text="@string/apply_changes"
            android:textColor="@color/widget_editor_black"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
