<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_editor_black">
    <ScrollView
        android:id="@+id/editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/editor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Raised top panel: title, live preview, the widgets on the home screen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_editor_panel"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="56dp"
                android:paddingEnd="24dp"
                android:paddingBottom="22dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:id="@+id/btn_back"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:contentDescription="@string/back"
                        android:focusable="true"
                        android:visibility="gone">
                        <ImageView android:importantForAccessibility="no"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_chev_l_2"
                            app:tint="@color/widget_editor_text" />
                    </FrameLayout>
                    <TextView
                        style="@style/TB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/widgets"
                        android:textColor="@color/widget_editor_text"
                        android:lineHeight="36sp"
                        android:textSize="28sp" />
                    <FrameLayout
                        android:id="@+id/btn_choose_widget"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/widget_editor_round"
                        android:clickable="true"
                        android:contentDescription="@string/add_widget"
                        android:focusable="true">
                        <ImageView android:importantForAccessibility="no"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus_2"
                            app:tint="@color/widget_editor_gold" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Pager frame: while dragging, the neighbouring widget (preview_peek) slides in beside the card. -->
                <FrameLayout
                    android:id="@+id/preview_pager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                <FrameLayout
                    android:id="@+id/preview_peek"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:background="@drawable/widget_editor_preview_face"
                    android:importantForAccessibility="noHideDescendants"
                    android:padding="16dp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/preview_face"
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        android:background="@drawable/widget_editor_preview_face"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/preview_arabic"
                            style="@style/ArB"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/widget_editor_gold"
                            android:textSize="28sp" />
                        <TextView
                            android:id="@+id/preview_meta"
                            style="@style/T"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/widget_editor_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/preview_size"
                        style="@style/TM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/widget_editor_gold"
                        android:textSize="11sp" />
                </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/placed_widgets"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Icon tabs and their settings -->
            <LinearLayout
                android:id="@+id/editor_tabs"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:orientation="horizontal" />
            <FrameLayout
                android:id="@+id/tab_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Appears once the preview scrolls away, so widgets can be switched from anywhere -->
    <LinearLayout
        android:id="@+id/mini_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/widget_editor_panel"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="40dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/mini_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/previous_widget"
            android:focusable="true">
            <ImageView android:importantForAccessibility="no"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:autoMirrored="true"
                android:src="@drawable/ic_chev_l_2"
                app:tint="@color/widget_editor_gold" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mini_title"
                style="@style/TM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_editor_text"
                android:textSize="14sp" />
            <LinearLayout
                android:id="@+id/mini_dots"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/mini_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/next_widget"
            android:focusable="true">
            <ImageView android:importantForAccessibility="no"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:autoMirrored="true"
                android:src="@drawable/ic_chev_r_2"
                app:tint="@color/widget_editor_gold" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">
    <include layout="@layout/view_nav" android:layout_width="match_parent" android:layout_height="88dp"/>
    </LinearLayout>
</FrameLayout>
