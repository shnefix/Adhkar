<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- The card (its colour and corners can be customised), stretched to the space the widget really has. -->
    <ImageView android:id="@+id/img_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null" android:importantForAccessibility="no"/>
    <!-- Taps on the margins around the picture count too. -->
    <FrameLayout android:id="@+id/hit_bg" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <!-- The picture keeps its own proportions; this box takes its size, so the tap areas stay on what they cover
         (left to right, as the picture is drawn in every language). -->
    <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
        android:layoutDirection="ltr">
    <ImageView android:id="@+id/img" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="@null"/>
    <!-- FrameLayout stretches its match_parent children to its own size only when it has two or more; this keeps it so. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:id="@+id/hit_open" android:layout_width="match_parent" android:layout_height="56dp"/>
        <FrameLayout android:id="@+id/hit_count" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <!-- bottom row: 52dp tall, 19dp from the bottom/right edge, "+1" button is 56dp wide -->
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="71dp"
            android:paddingBottom="19dp" android:paddingEnd="19dp">
            <FrameLayout android:id="@+id/hit_count2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            <FrameLayout android:id="@+id/btn_plus" android:layout_width="56dp" android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
