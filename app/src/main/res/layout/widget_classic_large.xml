<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/img" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:id="@+id/hit_open" android:layout_width="match_parent" android:layout_height="56dp"/>
        <FrameLayout android:id="@+id/hit_count" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <!-- bottom row: 52dp tall, 19dp from the bottom/right edge, "+1" button is 56dp wide -->
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="71dp"
            android:paddingBottom="19dp" android:paddingEnd="19dp">
            <FrameLayout android:id="@+id/hit_count2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            <FrameLayout android:id="@+id/btn_plus" android:layout_width="56dp" android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
