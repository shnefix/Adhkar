<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:clickable="true" android:focusable="true" android:minHeight="116dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<View android:id="@+id/mark" android:visibility="gone" android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="top|end" android:layout_marginTop="-22dp" android:layout_marginEnd="-22dp"/>
<LinearLayout android:orientation="vertical" android:padding="14dp" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/ic_wrap" android:orientation="vertical" android:gravity="center" android:layout_width="38dp" android:layout_height="38dp">
<ImageView android:id="@+id/ic" android:importantForAccessibility="no" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" app:tint="@color/teal"/>
<TextView android:id="@+id/emoji" android:visibility="gone" android:textSize="20sp" android:includeFontPadding="false" android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
<TextView style="@style/TB" android:id="@+id/title" android:layout_marginTop="14dp" android:textSize="16sp" android:textColor="@color/light" android:maxLines="2" android:ellipsize="end" android:textAlignment="textStart" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:id="@+id/sub" android:textSize="12sp" android:textColor="@color/hint" android:textAlignment="textStart" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</FrameLayout>
