<?xml version="1.0" encoding="utf-8"?>
<com.azkar.app.ui.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/swipe" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="12dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp" android:background="@color/bg">
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<FrameLayout android:id="@+id/btn_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_card22" android:contentDescription="@string/back" android:clickable="true" android:focusable="true">
<ImageView android:importantForAccessibility="no" android:src="@drawable/ic_chev_l_2" android:layout_width="20dp" android:layout_height="20dp" app:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
<LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:gravity="center_horizontal" android:layout_height="wrap_content">
<TextView style="@style/TB" android:text="" android:textSize="17sp" android:textColor="@color/text" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:id="@+id/pos" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<View android:layout_width="44dp" android:layout_height="44dp"/>
</LinearLayout>

<!-- Everything under the header turns over between the reader (front) and the source page (back). -->
<FrameLayout android:id="@+id/flip_area" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp">

<LinearLayout android:id="@+id/front" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
<com.azkar.app.ui.ReaderScrubber android:id="@+id/segs" android:layout_marginTop="4dp" android:layout_marginStart="-10dp" android:layout_marginEnd="-10dp" android:layout_width="match_parent" android:layout_height="32dp"/>
<LinearLayout android:id="@+id/card" android:orientation="vertical" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:padding="22dp" android:background="@drawable/bg_card28" android:gravity="center">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never" android:id="@+id/ar_scroll">
<LinearLayout android:orientation="vertical" android:gravity="center" android:padding="0dp" android:minHeight="0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/TB" android:id="@+id/title_above" android:visibility="gone" android:textSize="15sp" android:textColor="@color/gold" android:lineHeight="22sp" android:gravity="center" android:textDirection="firstStrong" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView style="@style/Ar" android:text="" android:textSize="26sp" android:textColor="@color/arabic" android:lineHeight="48.1sp" android:gravity="center" android:textDirection="rtl" android:id="@+id/ar" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView style="@style/TB" android:id="@+id/title_below" android:visibility="gone" android:textSize="15sp" android:textColor="@color/gold" android:lineHeight="22sp" android:gravity="center" android:textDirection="firstStrong" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:id="@+id/note" android:visibility="gone" android:textSize="14sp" android:textColor="@color/muted" android:lineHeight="21sp" android:gravity="center" android:textDirection="firstStrong" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<View android:layout_width="36dp" android:layout_height="2dp" android:background="@color/gold" android:layout_gravity="center" android:layout_marginTop="18dp"/>
</LinearLayout>
</ScrollView>
</LinearLayout>
<FrameLayout android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="vertical" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<com.azkar.app.ui.RingView android:id="@+id/ring" android:layout_width="140dp" android:layout_height="140dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/widget_action_count">
<LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView style="@style/TB" android:text="0" android:textSize="44sp" android:textColor="@color/gold" android:lineHeight="48sp" android:id="@+id/count" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView style="@style/T" android:text="" android:textSize="14sp" android:textColor="@color/muted" android:id="@+id/sub" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
</com.azkar.app.ui.RingView>
<LinearLayout android:orientation="horizontal" android:layout_height="24dp" android:gravity="center" android:layout_marginTop="14dp" android:layout_width="match_parent">
<TextView style="@style/T" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:id="@+id/hint" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
</LinearLayout>
<!-- Source button: beside the counting ring, on the right; only when the zikr has a source. -->
<FrameLayout android:id="@+id/btn_source" android:visibility="gone" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="right|top" android:layout_marginTop="42dp" android:layout_marginRight="6dp" android:background="@drawable/bg_source_btn" android:contentDescription="@string/source_show" android:clickable="true" android:focusable="true">
<ImageView android:importantForAccessibility="no" android:src="@drawable/ic_open_book" android:layout_width="24dp" android:layout_height="24dp" app:tint="@color/gold" android:layout_gravity="center"/>
</FrameLayout>
</FrameLayout>
</LinearLayout>

<LinearLayout android:id="@+id/source_page" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:id="@+id/source_scroll" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="rtl">
<LinearLayout android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginTop="20dp" android:paddingTop="26dp" android:paddingBottom="22dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="@drawable/bg_card28" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView style="@style/Ar" android:id="@+id/src_ar" android:textSize="24sp" android:textColor="@color/arabic" android:lineHeight="44sp" android:gravity="center" android:textDirection="rtl" android:maxLines="8" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<View android:layout_width="40dp" android:layout_height="2dp" android:background="@color/gold" android:layout_marginTop="14dp"/>
<TextView style="@style/T" android:id="@+id/src_note" android:visibility="gone" android:textSize="14sp" android:textColor="@color/muted" android:lineHeight="21sp" android:gravity="center" android:textDirection="firstStrong" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:id="@+id/src_cards" android:orientation="vertical" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<com.azkar.app.ui.FlowLayout android:id="@+id/src_chips" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
<TextView style="@style/TB" android:id="@+id/src_back" android:text="@string/source_hide" android:textSize="16sp" android:textColor="@color/bg" android:gravity="center" android:background="@drawable/bg_gold26" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" android:layout_width="match_parent" android:layout_height="52dp"/>
</LinearLayout>

</FrameLayout>
</com.azkar.app.ui.SwipeLayout>
