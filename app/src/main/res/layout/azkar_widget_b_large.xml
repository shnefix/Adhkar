<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/azkar_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />
    <FrameLayout
        android:id="@+id/azkar_widget_hit"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- Bottom button row. Matches the bitmap: 18dp margins, 44dp tall, undo 56dp, then two equal buttons 10dp apart. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">
        <FrameLayout
            android:id="@+id/azkar_widget_undo"
            android:layout_width="56dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/azkar_widget_reset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/azkar_widget_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
