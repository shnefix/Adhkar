<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="56dp" android:paddingStart="24dp" android:paddingEnd="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<FrameLayout android:id="@+id/btn_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_card22" android:contentDescription="Back to Library" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_chev_l_2" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
<TextView style="@style/TB" android:id="@+id/title" android:text="" android:textSize="18sp" android:textColor="@color/text" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<FrameLayout android:id="@+id/btn_edit" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_card22" android:contentDescription="Edit folder" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_pencil_1p75" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="32dp" android:clipToPadding="false" android:overScrollMode="never" android:scrollbars="none"/>
<TextView style="@style/T" android:id="@+id/empty" android:text="No azkar in this folder yet. Add one from My azkar." android:textSize="15sp" android:textColor="@color/muted" android:lineHeight="22sp" android:gravity="center" android:paddingVertical="28dp" android:paddingHorizontal="18dp" android:background="@drawable/bg_dashline20" android:visibility="gone" android:layout_margin="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</FrameLayout>
</LinearLayout>