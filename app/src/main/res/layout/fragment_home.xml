<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none" android:overScrollMode="ifContentScrolls">
<LinearLayout android:orientation="vertical" android:id="@+id/content" android:paddingTop="48dp" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="120dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="horizontal" android:gravity="end" android:layout_width="match_parent" android:layout_height="wrap_content">
<FrameLayout android:id="@+id/btn_notifications" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_card22" android:contentDescription="Settings" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_bell_1p75" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/text" android:layout_gravity="center"/>
</FrameLayout>
<LinearLayout android:orientation="horizontal" android:id="@+id/btn_customize" android:layout_width="wrap_content" android:layout_height="44dp" android:paddingStart="14dp" android:paddingEnd="16dp" android:gravity="center_vertical" android:background="@drawable/bg_card22" android:clickable="true" android:focusable="true">
<ImageView android:src="@drawable/ic_sliders_1p75" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/text"/>
<TextView style="@style/TB" android:text="Customize" android:textSize="14sp" android:textColor="@color/text" android:layout_marginStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:id="@+id/sections" android:layout_marginTop="0dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
<include layout="@layout/view_nav" android:layout_width="match_parent" android:layout_height="88dp" android:layout_gravity="bottom"/>
</FrameLayout>
